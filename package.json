{
	"name": "@stevygee/master-builder",
	"version": "0.8.0",
	"description": "A reusable builder to compile es6 and scss from a source directory into a destination directory",
	"bin": {
		"master-builder": "bin/index.js"
	},
	"main": "bin/index.js",
	"type": "module",
	"scripts": {
		"start": "master-builder",
		"build": "master-builder build",
		"deploy": "master-builder deploy",
		"serve": "light-server -s dist/packages/master-builder -p 8080"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com:stevygee/master-builder.git"
	},
	"author": "Stefan Grassberger",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/stevygee/master-builder/issues"
	},
	"homepage": "https://github.com/stevygee/master-builder#readme",
	"dependencies": {
		"ansi-colors": "^4.1.3",
		"asciify": "^1.3.5",
		"autoprefixer": "^10.4.21",
		"browserslist": "^4.25.4",
		"cpy": "^8.1.2",
		"del": "^8.0.0",
		"esbuild": "^0.25.9",
		"esbuild-plugin-browserslist": "^1.0.1",
		"esbuild-sass-plugin": "^3.3.1",
		"fancy-log": "^2.0.0",
		"glob": "^11.0.3",
		"gulp-size": "^5.0.0",
		"gulp-zip": "^6.1.0",
		"node-notifier": "^10.0.1",
		"postcss": "^8.5.6",
		"postcss-preset-env": "^10.3.1",
		"sass-embedded": "^1.72.0",
		"vinyl-fs": "^4.0.2"
	},
	"devDependencies": {
		"classnames": "^2.5.1",
		"light-server": "^2.9.1",
		"lodash": "^4.17.21"
	}
